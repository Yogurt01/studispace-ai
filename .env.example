# Required for Gemini chat, quiz generation, notes transformation, and flashcards.
# Keep this server-side; do not expose it to the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Application (server-side, non-secret). APP_URL is optional and useful for deployment links.
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Vite development only (optional): set true in constrained editing environments.
DISABLE_HMR=false

# Production server credential discovery uses Firebase Application Default Credentials.
# For local emulators, set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path
# outside this repository. Never commit service-account JSON files.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Firebase client configuration for the browser app.
# Values are public and should match your Firebase web app config.
#
# IMPORTANT: all six values must come from the SAME Firebase web app.
# VITE_FIREBASE_AUTH_DOMAIN hosts the OAuth handler; if it names a different
# project than VITE_FIREBASE_PROJECT_ID, Google sign-in fails.
#
# Google sign-in additionally checks the browser's hostname (never the port)
# against Firebase Console -> Authentication -> Settings -> Authorized domains.
# "localhost" and "127.0.0.1" are authorized for this project, so open the dev
# server at http://localhost:3000. Opening it on a LAN IP (e.g. 192.168.x.x) or
# a tunnel hostname fails with auth/unauthorized-domain until you add that exact
# hostname to the Authorized domains list.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Local open-source model runtime (Ollama + Qwen3). Configuration, not secrets:
# Ollama runs on this machine and needs no API key. Leave unset to use the defaults.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Which model runtimes this deployment offers (comma separated). Unset = both.
# Cloud deployments have no Ollama of their own, so they set: AI_PROVIDERS=gemini
AI_PROVIDERS=

# The Socratic selector offers three models, and the default is always the free
# one (Gemini 2.5 Flash) — it is not configurable, so no deployment can greet a
# student with a locked model.
#
# Optional overrides for the two Gemini slots. The button label follows whatever
# is set here, so the selector can never name a model the server is not calling.
# Free student model; defaults to gemini-2.5-flash.
GEMINI_FREE_MODEL=
# Developer-only model; defaults to gemini-3.7-flash. GEMINI_MODEL is the older
# name for this and is still honoured.
GEMINI_DEVELOPER_MODEL=
GEMINI_MODEL=

# Password for Developer Mode, which unlocks Gemini 3.7 Flash and Qwen3 Local.
# Server-side only: it is never sent to the browser, never bundled into the
# client, and never written to /runtime-config.js. Leave it unset and the
# developer-only models stay unreachable on this server. Rotating it invalidates
# every outstanding unlock token.
DEVELOPER_MODE_PASSWORD=

# Local browser E2E only (npm run test:e2e:local). CI never needs these.
E2E_EMAIL=
E2E_PASSWORD=
