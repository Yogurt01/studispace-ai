rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // The stored document belongs to the caller (read / update / delete).
    function ownsExistingDoc() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // The document being written is stamped with the caller's own uid (create / update).
    function ownsIncomingDoc() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // User profiles & stats — private to their owner.
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Socratic AI Chats — messages and LangGraph conversation state are private
    // to their owner. Queries must be scoped with where("userId", "==", uid).
    match /chats/{chatId} {
      allow read: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsExistingDoc() && ownsIncomingDoc();
      allow delete: if ownsExistingDoc();
    }

    // Uploaded study document metadata — private to the uploader.
    match /documents/{documentId} {
      allow read: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsExistingDoc() && ownsIncomingDoc();
      allow delete: if ownsExistingDoc();
    }

    // Shared study content. These collections mix per-user documents with the
    // seeded `userId: "system"` starter set that every student sees, and the app
    // reads them as whole collections, so they stay collection-readable — but only
    // to signed-in students, never anonymously.
    match /quizzes/{quizId} {
      allow read, write: if isAuthenticated();
    }

    match /notes/{noteId} {
      allow read, write: if isAuthenticated();
    }

    match /assignments/{assignmentId} {
      allow read, write: if isAuthenticated();
    }

    match /decks/{deckId} {
      allow read, write: if isAuthenticated();
    }
  }
}
